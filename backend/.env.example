# Copied to backend/.env on npm install

# SQLite database, path is relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"
PORT=3000

SESSION_SECRET="tolltally-dev-secret-change-me-for-production"
SESSION_TTL_MINUTES=30

# "mock" works offline, "onemap" needs a free account from https://www.onemap.gov.sg/apidocs/
ROUTING_PROVIDER=onemap
ONEMAP_EMAIL=""
ONEMAP_PASSWORD=""
# optional, gives alternative routes when using onemap
GOOGLE_ROUTES_API_KEY=

# "table" uses the seeded carparks, "mock" uses a fixed rate
PARKING_PROVIDER=table

ESTIMATE_BUDGET_MS=3000
COMPARISON_BUDGET_MS=10000

ERP_BOUNDARY_TOLERANCE_MIN=5
# A route counts a gantry when it passes within this many metres, heading within this many degrees
ERP_CROSSING_DISTANCE_M=60
ERP_CROSSING_HEADING_DEG=60
FUEL_RANGE_PERCENT=5
ROUTE_OPTION_COUNT=3
DEPARTURE_WINDOW_MIN=60
DEPARTURE_INTERVAL_MIN=15
PARKING_SEARCH_RADIUS_KM=1
DEFAULT_PARKING_DURATION_MIN=60
FRESHNESS_FUEL_DAYS=7
FRESHNESS_ERP_DAYS=180
FRESHNESS_PARKING_DAYS=30

# admin account created by the seed
ADMIN_EMAIL=admin@tolltally.local
ADMIN_PASSWORD=Admin1234

# LTA DataMall account key, for live traffic incidents on the estimate page. Request one at
# https://datamall.lta.gov.sg (it arrives by email). Check it with: npm run feeds:check
LTA_ACCOUNT_KEY=

# Live road and weather information beside each estimate. It never changes the estimate.
# auto: traffic uses LTA when LTA_ACCOUNT_KEY is set, demo incidents in demo routing mode, else off.
#       weather uses data.gov.sg (no key needed), or demo forecasts in demo routing mode.
# Set either to off to hide it; lta/nea force the live feed, mock forces the demo data.
TRAFFIC_PROVIDER=auto
WEATHER_PROVIDER=auto
# optional: a data.gov.sg API key raises the forecast request limit
DATA_GOV_SG_API_KEY=
# incidents are shown for trips leaving within this many minutes, if within this many metres of the route
INCIDENT_WINDOW_MIN=120
INCIDENT_DISTANCE_M=300

# Request limits against password guessing and OneMap quota abuse. Leave on outside tests.
RATE_LIMITS=on

# Password reset emails. Leave SMTP_HOST empty and the reset link is printed in this terminal instead.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=your Gmail address,
# SMTP_PASS=a Gmail app password (not your normal password), MAIL_FROM="TollTally <your Gmail address>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TollTally <no-reply@tolltally.local>"
# The site address used in reset links. Required in production (Render sets it automatically).
APP_URL=
